# ─── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by the app.
# Supabase on Vercel: the TRANSACTION pooler (port 6543), e.g.
#   postgresql://postgres.<ref>:<password>@aws-<n>-eu-west-2.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true
DATABASE_URL="postgresql://user:password@host:5432/coco?sslmode=require"
# Session connection for migrations (Supabase: the SESSION pooler, same host, port 5432). Optional elsewhere.
DIRECT_URL=""
# Connections per server instance. Use 1 on Vercel with a transaction pooler.
DATABASE_POOL_MAX="10"
# Public URL of the site — used in emails, canonical URLs and the sitemap
APP_URL="https://cocotamarindhp27.co.uk"
# 32+ random characters. Signs guest "manage booking" links. Changing it invalidates existing links.
APP_SECRET=""
# Random string; scheduled jobs must send "Authorization: Bearer <CRON_SECRET>" (Vercel Cron does this)
CRON_SECRET=""
# Set to 1 ONLY on the live production domain. Every other deployment is noindex.
ALLOW_INDEXING="0"

# ─── Email (Resend) — awaiting configuration until set ───────────────────────
RESEND_API_KEY=""
# A sender on a domain verified in Resend, e.g. "Coco Tamarind <bookings@cocotamarindhp27.co.uk>"
EMAIL_FROM=""
EMAIL_REPLY_TO="cocotamarindhp27@gmail.com"
# Where staff notifications go (defaults to the email in Site settings)
ADMIN_NOTIFY_EMAIL=""
# Development only: "log" prints emails to the console instead of sending them
EMAIL_TRANSPORT=""

# ─── Image storage (Cloudinary) — awaiting configuration until set ───────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Analytics — loaded only after visitor consent ───────────────────────────
NEXT_PUBLIC_GTM_ID=""

# ─── First admin account (used by `npm run db:seed`) ─────────────────────────
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""
# Leave empty to have a random temporary password printed once
SEED_ADMIN_PASSWORD=""
# Local development only: create demo Manager / Front of house / Editor accounts
SEED_DEMO="0"
SEED_DEMO_PASSWORD=""

# ─── Testing ─────────────────────────────────────────────────────────────────
# Disposable databases — they are wiped by the test suites
TEST_DATABASE_URL=""
E2E_DATABASE_URL=""
# Use an installed Chrome for Playwright instead of downloading browsers
PLAYWRIGHT_CHROME_PATH=""
